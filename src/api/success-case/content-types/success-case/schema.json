{
  "kind": "collectionType",
  "collectionName": "success_cases",
  "info": {
    "singularName": "success-case",
    "pluralName": "success-cases",
    "displayName": "successCase"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "excerpt": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "challenge": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "legalMove": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "result": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "whyItMatters": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "locationLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seo": {
      "type": "component",
      "pluginOptions": { "i18n": { "localized": true } },
      "component": "seo.seo",
      "repeatable": false
    },
    "practice_areas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::practice-area.practice-area",
      "inversedBy": "success_cases"
    },
    "services": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service",
      "mappedBy": "success_cases"
    },
    "sections": {
      "type": "dynamiczone",
      "pluginOptions": { "i18n": { "localized": true } },
      "components": [
        "dynamic-zone.rich-content"
      ]
    },
    "order": {
      "type": "integer",
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
