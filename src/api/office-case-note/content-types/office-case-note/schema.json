{
  "kind": "collectionType",
  "collectionName": "office_case_notes",
  "info": {
    "singularName": "office-case-note",
    "pluralName": "office-case-notes",
    "displayName": "Office Case Note",
    "description": "Authored, timestamped notes in a legal matter"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "officeCase": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::office-case.office-case",
      "inversedBy": "caseNotes",
      "required": true
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "body": { "type": "text", "required": true },
    "visibility": {
      "type": "enumeration",
      "required": true,
      "default": "internal",
      "enum": ["internal", "client"]
    },
    "isPinned": { "type": "boolean", "default": false }
  }
}
