{
  "kind": "collectionType",
  "collectionName": "office_cases",
  "info": {
    "singularName": "office-case",
    "pluralName": "office-cases",
    "displayName": "Office Case",
    "description": "General office cases managed from the KA admin"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "caseNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string"
    },
    "client": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::client.client",
      "inversedBy": "officeCases",
      "required": true
    },
    "assignedLawyer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "teamMembers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user"
    },
    "matterType": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::office-case-type.office-case-type",
      "inversedBy": "officeCases"
    },
    "field": {
      "type": "enumeration",
      "required": true,
      "default": "litigation",
      "enum": [
        "litigation",
        "real_estate",
        "inheritance",
        "contracts",
        "business",
        "other"
      ]
    },
    "status": {
      "type": "enumeration",
      "required": true,
      "default": "intake",
      "enum": [
        "intake",
        "conflict_check",
        "active",
        "waiting",
        "documents",
        "drafting",
        "review",
        "ready",
        "filed",
        "on_hold",
        "closed",
        "archived"
      ]
    },
    "description": {
      "type": "text"
    },
    "priority": {
      "type": "enumeration",
      "required": true,
      "default": "normal",
      "enum": ["low", "normal", "high", "urgent"]
    },
    "confidentiality": {
      "type": "enumeration",
      "required": true,
      "default": "standard",
      "enum": ["standard", "confidential", "highly_confidential"]
    },
    "packageStatus": {
      "type": "enumeration",
      "default": "draft",
      "enum": [
        "draft",
        "missing_data",
        "review",
        "ready"
      ]
    },
    "statementTitle": {
      "type": "string",
      "default": "כתב תביעה"
    },
    "court": {
      "type": "string"
    },
    "plaintiff": {
      "type": "text"
    },
    "defendant": {
      "type": "text"
    },
    "claimValue": {
      "type": "string"
    },
    "causes": {
      "type": "text"
    },
    "facts": {
      "type": "richtext"
    },
    "remedies": {
      "type": "text"
    },
    "propertyAddress": {
      "type": "string"
    },
    "propertyType": {
      "type": "string"
    },
    "propertyBlock": {
      "type": "string"
    },
    "propertyParcel": {
      "type": "string"
    },
    "propertySubparcel": {
      "type": "string"
    },
    "transactionValue": {
      "type": "decimal",
      "min": 0
    },
    "feePercentage": {
      "type": "decimal",
      "min": 0,
      "max": 100
    },
    "documents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::office-case-document.office-case-document",
      "mappedBy": "officeCase"
    },
    "caseNotes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::office-case-note.office-case-note",
      "mappedBy": "officeCase"
    },
    "tasks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::office-case-task.office-case-task",
      "mappedBy": "officeCase"
    },
    "feeAgreements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::office-case-fee-agreement.office-case-fee-agreement",
      "mappedBy": "officeCase"
    },
    "payments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::office-case-payment.office-case-payment",
      "mappedBy": "officeCase"
    },
    "files": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "openedAt": {
      "type": "date",
      "required": true
    },
    "targetDate": {
      "type": "date"
    },
    "closedAt": {
      "type": "date"
    }
  }
}
