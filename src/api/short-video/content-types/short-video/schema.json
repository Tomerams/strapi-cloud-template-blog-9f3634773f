{
  "kind": "collectionType",
  "collectionName": "short_videos",
  "info": {
    "singularName": "short-video",
    "pluralName": "short-videos",
    "displayName": "Short videos",
    "description": "YouTube Shorts assigned to relevant pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "youtubeUrl": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "maxLength": 500,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "poster": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "services": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "practice_areas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::practice-area.practice-area",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sectors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::sector.sector",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "locations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::location.location",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "posts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::post.post",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "uploadDate": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "durationSeconds": {
      "type": "integer",
      "min": 1,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
